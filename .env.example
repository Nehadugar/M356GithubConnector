# Copy this file to .env and fill in the values. Never commit .env.

# --- Microsoft Entra app registration (application permissions with admin consent) ---
# Required Graph application permissions: ExternalConnection.ReadWrite.OwnedBy, ExternalItem.ReadWrite.OwnedBy
TENANT_ID=<your-tenant-id>
CLIENT_ID=<your-app-client-id>
CLIENT_SECRET=<your-client-secret>

# --- GitHub source ---
# Repository to index, as owner/repo
GITHUB_REPO=Nehadugar/CopilotConnectorDemo
# Optional for public repositories; required for private repositories.
# Fine-grained token with read-only "Issues" and "Metadata" permissions on that repository.
GITHUB_TOKEN=<your-github-token-or-leave-empty>

# --- Copilot connector (optional overrides) ---
# 3-32 alphanumeric characters, must not start with "Microsoft". Use a new ID per connection.
CONNECTION_ID=githubissuespoc
CONNECTION_NAME=GitHub Issues POC
CONNECTION_DESCRIPTION=Open and closed GitHub issues from the configured repository.
